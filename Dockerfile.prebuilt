# GanCook-10k · 快速部署用的「预构建」镜像
#
# 和官方 Dockerfile 的区别：不在镜像里 npm ci / next build（NAS 上要 20~30 分钟），
# 而是直接拷贝宿主机上已经 `next build` 好的 standalone 运行包，部署只需几十秒。
#
# 前提：宿主机是 Debian 12 (bookworm, glibc) + Node 22，与下面的基础镜像一致，
#       better-sqlite3 / sharp 原生模块二进制可直接复用。
# 忽略规则见 Dockerfile.prebuilt.dockerignore（务必排除 .next/standalone/data，里面是开发库）

ARG BASE_IMAGE=node:22-bookworm-slim
FROM ${BASE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    DATA_DIR=/data \
    TZ=Asia/Shanghai

# gosu 与非 root 用户 app：若离线底座（如 gancook-base:node22）已预装则秒级跳过，无需联网
RUN command -v gosu >/dev/null 2>&1 || (apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/*)
RUN id -u app >/dev/null 2>&1 || (groupadd -r app && useradd -r -g app app)

ARG APP_VERSION=v0.5.1
ENV APP_VERSION=$APP_VERSION

COPY --chown=app:app .next/standalone ./
COPY --chown=app:app .next/static ./.next/static
COPY --chown=app:app public ./public
COPY --chown=app:app drizzle ./drizzle
COPY docker-entrypoint.sh /app/docker-entrypoint.sh

RUN chmod +x /app/docker-entrypoint.sh && mkdir -p /data && chown app:app /data
VOLUME /data

EXPOSE 3000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
