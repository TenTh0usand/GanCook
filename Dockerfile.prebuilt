# GanCook-10k · 快速部署用的「预构建」镜像
#
# 和官方 Dockerfile 的区别：不在镜像里 npm ci / next build（NAS 上要 20~30 分钟），
# 而是直接拷贝宿主机上已经 `next build` 好的 standalone 运行包，部署只需几十秒。
#
# 前提：宿主机是 Debian 12 (bookworm, glibc) + Node 22，与下面的基础镜像一致，
#       better-sqlite3 / sharp 原生模块二进制可直接复用。
# 用法：先在项目目录执行 `npx next build`，再 `docker build -f Dockerfile.prebuilt .`
#       （manage.sh deploy 会自动完成这两步）
# 忽略规则见 Dockerfile.prebuilt.dockerignore（务必排除 .next/standalone/data，里面是开发库）

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    DATA_DIR=/data \
    TZ=Asia/Shanghai

# gosu：以 root 启动入口脚本后降权到 app（与官方镜像一致）。这一层只在第一次构建时下载，之后走缓存
RUN apt-get update && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app && useradd -r -g app app

# 版本号放在依赖层之后，改版本不会让上面的层失效
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION

COPY --chown=app:app .next/standalone ./
COPY --chown=app:app .next/static ./.next/static
COPY --chown=app:app public ./public
COPY --chown=app:app drizzle ./drizzle
COPY docker-entrypoint.sh /app/docker-entrypoint.sh

RUN chmod +x /app/docker-entrypoint.sh && mkdir -p /data && chown app:app /data
VOLUME /data

EXPOSE 3000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
